# Docker Compose sets this URL directly; change docker-compose.yml to override it.
VITE_API_URL=http://backend:8080
# Public frontend URL, including the scheme. Use http://localhost:5173 for local Docker testing.
ORIGIN=https://example.com
# VITE_ALLOWED_HOSTS only affects Vite dev/preview, not the production Node server.
# Used so that views are only counted from the frontend
# Must be the same on both the frontend and backend environment
# Production fallback: View_HMAC_Internal_API_Key (not PasteSettings__View_Internal_API_Key).
# Replace this placeholder with the same generated value as the backend setting.
VIEW_INTERNAL_API_KEY=replace_with_the_same_random_internal_api_key_in_both_files
