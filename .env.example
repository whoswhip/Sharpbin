# Copy to .env in the repository root. Replace every replace_with_ value before running.
# Generate a different random value for each secret. See README.md for instructions.

# Site
Domain=example.com
Https=true
AllowedCorsOrigins__0=https://example.com
ORIGIN=https://example.com

# Authentication
JwtSettings__Secret=replace_with_a_unique_random_jwt_secret_before_running
# These Turnstile keys are for testing. Use your own site and secret keys in production.
AuthSettings__CF_Turnstile_SecretKey=1x0000000000000000000000000000000AA
AuthSettings__CF_Turnstile_SiteKey=3x00000000000000000000FF
AuthSettings__Registration_Enabled=true
AuthSettings__Admins_Require_2FA=true
AuthSettings__API_Key_HMAC_Secret=replace_with_a_unique_random_api_key_hmac_secret_before_running

# Pastes
PasteSettings__MaxTitleLength=500
PasteSettings__MaxPasteSizeInBytes=1048576
PasteSettings__EnablePasteCompression=true
PasteSettings__RequiresVerification=true
PasteSettings__View_HMAC_Secret=replace_with_a_unique_random_view_hmac_secret_before_running
# Compose passes this value to both services. No separate frontend key is needed.
PasteSettings__View_Internal_API_Key=replace_with_a_unique_random_internal_api_key_before_running
